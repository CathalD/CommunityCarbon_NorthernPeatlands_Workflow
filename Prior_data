// ---- FOREST CARBON ------------------------------------------------------

// Sothe et al. 2022 forest carbon. Native kg C/m² (AGB+BGB+dead), ~2015–2019,
// 250 m. Mirror is an ImageCollection → .first() is the single national image.
function sotheForestCarbon(aoi) {
  return ee.ImageCollection(SOTHE_FC_COL).first().clip(aoi).rename('sothe_fc');
}

// SCANFI v1.2 (Guindon 2024). 30 m, 2020. band[0] = live aboveground dry tree
// biomass (Mg/ha); also 'height' (m), land cover, crown closure, species.
function scanfi(aoi) { return ee.Image(SCANFI_ASSET).clip(aoi); }

// SCANFI AGB → forest carbon (kg C/m², AGB+BGB).
function scanfiForestCarbon(aoi) {
  return agbToForestCarbon(scanfi(aoi).select([0])).rename('scanfi_fc');
}

// GEDI L4A aboveground biomass density (Mg/ha) + its SE, quality-masked,
// median-composited. Returns bands: agbd (Mg/ha), agbd_se (Mg/ha).
// NOTE: this is the RAW GEDI product, NOT carbon — apply agbToForestCarbon().
function gediL4A(aoi, startDate, endDate) {
  return ee.ImageCollection(GEDI_L4A_COL)
    .filterDate(startDate, endDate).filterBounds(aoi)
    .map(function(img) {
      var q = img.select('l4_quality_flag').eq(1).and(img.select('degrade_flag').eq(0));
      return img.select(['agbd', 'agbd_se']).updateMask(q);
    }).median().clip(aoi);
}

// GEDI L4A → forest carbon (kg C/m², AGB+BGB) + carbon-unit SE.
function gediForestCarbon(aoi, startDate, endDate) {
  var g = gediL4A(aoi, startDate, endDate);
  return agbToForestCarbon(g.select('agbd')).rename('gedi_fc')
    .addBands(agbToForestCarbon(g.select('agbd_se')).rename('gedi_fc_se'));
}

