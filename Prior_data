// ---- WETLAND / LAND COVER ----------------------------------------------
// GWL_FCS30 (Zhang 2023). Tiled global collection → filterBounds+mosaic for AOI
// coverage. Class codes: 180 non-wetland · 181 permanent water · 182 swamp ·
// 183 marsh · 184 flooded flat · 185 saline · 186 mangrove · 187 salt marsh ·
// 188 tidal flat. WETLAND_CODES below excludes 180 (dry) and 181 (open water).
var GWL_WETLAND_CODES = [182, 183, 184, 185, 186, 187, 188];
function gwlWetland(aoi) {
  return ee.ImageCollection(GWL_FCS30_COL).filterBounds(aoi).mosaic().clip(aoi).rename('gwl');
}
function gwlWetlandMask(aoi) {
  var gwl = gwlWetland(aoi);
  var ones = GWL_WETLAND_CODES.map(function() { return 1; });
  return gwl.remap(GWL_WETLAND_CODES, ones, 0).gt(0).rename('wetland');
}
// ESA WorldCover v200 (10 m). class 10 = tree cover.
function worldcover(aoi) {
  return ee.ImageCollection(WORLDCOVER_COL).first().clip(aoi).rename('worldcover');
}

// ---- FOUNDATION EMBEDDINGS ---------------------------------------------
// Google Satellite Embedding (AlphaEarth) — 64-band annual, 10 m. Pass a year
// or null for a multi-year median.
function satelliteEmbedding(aoi, year) {
  var col = ee.ImageCollection(SAT_EMBEDDING_COL).filterBounds(aoi);
  if (year !== null && year !== undefined) {
    col = col.filter(ee.Filter.calendarRange(year, year, 'year'));
  }
  return col.median().clip(aoi);
}

