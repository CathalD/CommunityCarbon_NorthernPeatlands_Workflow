// Sothe et al. 2022 soil carbon, FULL profile. Native kg C/m², 0–1 m, 250 m.
function sotheSoilCarbon(aoi) {
  return ee.ImageCollection(SOTHE_SC_COL).first().clip(aoi).rename('sothe_sc');
}

// Sothe et al. 2022 soil carbon, 0–30 cm cut (your uploaded asset). kg C/m².
// ⚠ DEPTH BASIS — this is the SAME Sothe product as sotheSoilCarbon() but a
//   SHALLOWER interval (0–30 cm vs 0–1 m). Never mix or average the two, and
//   match whichever you use to your cores' depth support (0–30 cm cores → this).
function sotheSoilCarbon30(aoi) {                                    // [PRIVATE]
  return ee.Image(SOTHE_SC30_ASSET).select([0]).clip(aoi).rename('sothe_sc_0_30');
}

// Li et al. 2025 — Hudson/James Bay peat carbon storage. 30 m, kg C/m².
// ⚠ DEPTH BASIS — the published product is FULL peat-COLUMN carbon (0 → base of
//   peat). HBL peat depth averages 184 (±48) cm and mean stock is ~86 (±35)
//   kg C/m², so this is DEEP total-column peat carbon, NOT a 0–30 cm or even a
//   0–100 cm layer. It must NEVER be averaged into a fixed shallow-depth soil
//   ensemble (e.g. the 0–30 cm SoilGrids/Sothe consensus). Peat-class pixels
//   only. Confirm the exact depth basis of your uploaded band — earlier project
//   notes labelled it "0–100 cm", which disagrees with the paper's full-column
//   headline map; verify before using it quantitatively.
function liPeatCarbon(aoi) {                                         // [PRIVATE]
  return ee.Image(LI_PEAT_C_ASSET).select([0]).clip(aoi).rename('li_peat_c');
}

// SoilGrids v2.0 OCS built from SOC concentration + bulk density.
// UNITS: SoilGrids soc_mean is dg/kg (×10 g/kg); bdod_mean is cg/cm³ (×100 g/cm³).
//   layer OCS (kg C/m²) = (soc/10 [g/kg]) × (bdod/100 [g/cm³]) × thickness_cm / 100
// Returns per-layer OCS + a 0–30 cm sum + a 0–100 cm sum (all kg C/m²).
// (Cross-checked dimensionally: peat SOC 400 g/kg, BD 0.2 g/cm³, 5 cm → 4.0 kg/m². ✓)
function soilgridsOCS(aoi) {
  var soc  = ee.Image(SG_SOC_ASSET).clip(aoi);
  var bdod = ee.Image(SG_BDOD_ASSET).clip(aoi);
  var layer = function(socB, bdB, thick) {
    return soc.select(socB).divide(10)
      .multiply(bdod.select(bdB).divide(100))
      .multiply(thick).divide(100);
  };
  var l = ee.Image([
    layer('soc_0-5cm_mean',    'bdod_0-5cm_mean',     5).rename('ocs_0_5cm'),
    layer('soc_5-15cm_mean',   'bdod_5-15cm_mean',   10).rename('ocs_5_15cm'),
    layer('soc_15-30cm_mean',  'bdod_15-30cm_mean',  15).rename('ocs_15_30cm'),
    layer('soc_30-60cm_mean',  'bdod_30-60cm_mean',  30).rename('ocs_30_60cm'),
    layer('soc_60-100cm_mean', 'bdod_60-100cm_mean', 40).rename('ocs_60_100cm')
  ]);
  var sum_0_30  = l.select(['ocs_0_5cm', 'ocs_5_15cm', 'ocs_15_30cm'])
                   .reduce(ee.Reducer.sum()).rename('sg_ocs_0_30cm');
  var sum_0_100 = l.reduce(ee.Reducer.sum()).rename('sg_ocs_0_100cm');
  return l.addBands(sum_0_30).addBands(sum_0_100);
}

