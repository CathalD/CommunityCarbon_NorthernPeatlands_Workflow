// ========================================================================
// SECTION 4 — ENSEMBLE MATH  (reusable, product-agnostic)
// ========================================================================
// Inverse-variance (precision) weighting: combine N carbon products into one
// best estimate + a combined σ.  w_i = 1/σ_i² ;  x̄ = Σ(w_i·x_i)/Σ(w_i) ;
// σ̄ = 1/√Σ(w_i).  Members absent at a pixel contribute zero weight, so the mean
// is taken over only the members actually present. Mask the result to a minimum
// member count downstream if you want an "≥k of N" rule.
//   members = [ {value: ee.Image, sigma: ee.Image}, ... ]  (same units + grid)
function inverseVarianceMean(members) {
  var wx = ee.Image(0), w = ee.Image(0);
  members.forEach(function(m) {
    var mask = ee.Image(m.value).mask();
    var wi   = ee.Image(m.sigma).pow(2).pow(-1).multiply(mask).unmask(0);
    wx = wx.add(ee.Image(m.value).unmask(0).multiply(wi));
    w  = w.add(wi);
  });
  return { mean: wx.divide(w).rename('wmean'), sigma: w.pow(-0.5).rename('wsigma') };
}
//
// ⚠ DERIVED-σ HEURISTIC (from v4.6, for products with no published per-pixel σ,
//   e.g. SoilGrids OCS): standardise the reference product's σ and the
//   inter-product disagreement SD to mean 1, average them, rescale to the
//   reference σ mean. It is a plausibility construction, NOT a validated
//   uncertainty — flag it wherever the SoilGrids weight matters.


